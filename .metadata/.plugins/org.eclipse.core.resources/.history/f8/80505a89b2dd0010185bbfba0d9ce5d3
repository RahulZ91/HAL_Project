void TIMER2_Init(void)
{
	TIM_OC_InitTypeDef tim2_pwm_config;
	// Higher level inits
	// for a time base of 1s
	htimer2.Instance=TIM2;
	htimer2.Init.Period=10000 - 1;
	htimer2.Init.Prescaler=4999;
	if(HAL_TIM_PWM_Init(&htimer2) != HAL_OK)  // init in OC
	{
		while(1);
	}

	memset(&tim2_pwm_config,0,sizeof(tim2_pwm_config)); // sets all the members of the structure to 0 to avoid garbage values
	// Configure the PWM
	tim2_pwm_config.OCMode=TIM_OCMODE_PWM1;
	tim2_pwm_config.OCPolarity=TIM_OCPOLARITY_HIGH; // signal high as long as CCR value less than Pulse value
	tim2_pwm_config.Pulse= htimer2.Init.Period * 0.25;//Specifies the pulse value to be loaded into the Capture Compare Register

	if(HAL_TIM_OC_ConfigChannel(&htimer2, &tim2_pwm_config, TIM_CHANNEL_1) != HAL_OK)
	{
		while(1);
	}

	tim2_pwm_config.Pulse= htimer2.Init.Period * 0.45;//Specifies the pulse value to be loaded into the Capture Compare Register


}

