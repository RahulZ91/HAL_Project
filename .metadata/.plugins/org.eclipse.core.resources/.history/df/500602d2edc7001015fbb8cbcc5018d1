#include<string.h>
#include "stm32f4xx_hal.h"
#include "main.h"
#include<stdio.h>

void SystemClockConfig(void);
void Timer6_Init(void);

TIM_HandleTypeDef htimer6;

int main(void)
{
	HAL_Init();
	SystemClockConfig(); // Application specification and not in HAL
	Timer6_Init();


	while(1);

	return 0;
}

void SystemClockConfig(void)
{
	// function to configure special clock configuration
}

void Timer6_Init(void)
{
	htimer6.Instance=TIM6;
	htimer6.Init.CounterMode = TIM_COUNTERMODE_UP; // basic counter always counts up - this is the only option
	htimer6.Init.Prescaler = 24;
	htimer6.Init.Period= 63999  ; // min value has to be 1 else the timer does not start

	if(HAL_TIM_Base_Init(&htimer6) != HAL_OK)
	{
		while(1);
	}
}
