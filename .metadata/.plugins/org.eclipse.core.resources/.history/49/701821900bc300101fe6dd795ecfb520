#include<string.h>
#include "stm32f4xx_hal.h"
#include "main.h"
#include<stdio.h>

void SystemClockConfig(uint8_t clock_freq);
void UART2_Init(void);


UART_HandleTypeDef huart2;



int main(void)
{
	HAL_Init();

	UART2_Init();         // High level initialization of UART2 peripheral


	while(1);

	return 0;
}

void SystemClockConfig(uint8_t clock_freq)
{
	// function to configure special clock configuration
	RCC_OscInitTypeDef osc_init;
	RCC_ClkInitTypeDef clk_init;

	// The PLL is used but it is sourced from the HSI hence the HSI is configured
	osc_init.OscillatorType = RCC_OSCILLATORTYPE_HSI;
	osc_init.HSIState=RCC_HSI_ON;
	osc_init.HSICalibrationValue=0x0F;

	// For PLL the structure - HAL for PLL_CFGR - we do not configure PLL Q and PLL R factors
	// PLLM, PLLN and PLLP are configured
	osc_init.PLL.PLLState=RCC_PLL_ON;
	osc_init.PLL.PLLSource=RCC_PLLSOURCE_HSI;
	switch(clock_freq)
	{
	case clock_freq_50MHz:
		osc_init.PLL.PLLM=16;
		osc_init.PLL.PLLN=100;
		osc_init.PLL.PLLP=2;

	case clock_freq_84MHz:
		osc_init.PLL.PLLM=16;
		osc_init.PLL.PLLN=21;
		osc_init.PLL.PLLP=1;

	case clock_freq_120MHz:
		osc_init.PLL.PLLM=16;
		osc_init.PLL.PLLN=240;
		osc_init.PLL.PLLP=2;

	}





}

void UART2_Init(void)
{
	huart2.Instance = USART2;  // base address of the UART2 peripheral - this is the typedef in the handle - always has the base address of peripheral
	huart2.Init.BaudRate=115200;
	huart2.Init.WordLength=UART_WORDLENGTH_8B;
	huart2.Init.StopBits=UART_STOPBITS_1;
	huart2.Init.Parity=UART_PARITY_NONE;
	huart2.Init.HwFlowCtl=UART_HWCONTROL_NONE;
	huart2.Init.Mode=UART_MODE_TX_RX;

	HAL_UART_Init(&huart2); // This was the fix done to get the output on the tera term - the peripheral was fully initialised

}
